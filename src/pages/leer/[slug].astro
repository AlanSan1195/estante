---
import '@fontsource-variable/literata/index.css';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/source-serif-4/index.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '../../styles/themes.css';
import '../../styles/reader.css';
import '../../styles/glass.css';
import '../../styles/study.css';
import AppLayout from '../../layouts/AppLayout.astro';
import { readCatalog } from '../../lib/catalog';
import Reader from '../../ui/reader/Reader';

export async function getStaticPaths() {
  const catalog = await readCatalog();
  return catalog.books.map((book) => ({
    params: { slug: book.slug },
    props: { title: book.title, cover: book.cover, background: book.palette.background },
  }));
}

const { slug } = Astro.params;
const { title, cover, background } = Astro.props;
---

<AppLayout title={`${title} · Estante`} reader>
  <Reader client:only="react" slug={slug} title={title}>
    <div slot="fallback" class="reader-fallback" aria-label="Cargando libro"></div>
  </Reader>
  {/*
    Portada de apertura, a pantalla completa sobre el color del libro: al abrir desde el estante, la
    portada crece hasta aquí (ui/bookTransition.ts) y esto se funde con la página cuando el lector
    está listo. También hace de pantalla de carga si se entra directamente a /leer/<slug>.
  */}
  <div class="reader-intro" style={{ background }} aria-hidden="true">
    <img src={cover} alt="" width="400" height="600" decoding="async" />
  </div>
</AppLayout>

<style is:global>
  .reader-fallback {
    position: fixed;
    inset: 0;
    background: var(--app-bg);
  }

  .reader-intro {
    position: fixed;
    z-index: 60;
    inset: 0;
    pointer-events: none;
    transition:
      opacity 0.28s var(--ease-out),
      transform 0.28s var(--ease-out);
  }

  .reader-intro img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Se funde cuando el lector está listo, pero no mientras la portada aún está creciendo. */
  html:not([data-astro-transition]) body:has(.reader[data-ready="true"]) .reader-intro {
    opacity: 0;
    transform: scale(1.04);
  }

  /*
   * Al cerrar, la página responde al toque mientras se descarga el estante: se aparta un poco y
   * redondea las esquinas; la transición sigue desde ahí hasta la portada.
   */
  html[data-closing] .reader {
    transform: scale(0.94);
    border-radius: 22px;
    transition:
      transform 0.5s cubic-bezier(0.32, 0.72, 0, 1),
      border-radius 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }

  html[data-closing] .rc-layer {
    opacity: 0;
    transition: opacity 0.16s var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .reader-intro,
    html[data-closing] .reader {
      transition-duration: 0.01s;
    }
  }
</style>
