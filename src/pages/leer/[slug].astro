---
import '@fontsource-variable/literata/index.css';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/source-serif-4/index.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '../../styles/themes.css';
import '../../styles/reader.css';
import '../../styles/glass.css';
import '../../styles/study.css';
import AppLayout from '../../layouts/AppLayout.astro';
import { readCatalog } from '../../lib/catalog';
import Reader from '../../ui/reader/Reader';

export async function getStaticPaths() {
  const catalog = await readCatalog();
  return catalog.books.map((book) => ({
    params: { slug: book.slug },
    props: { title: book.title, cover: book.cover, background: book.palette.background },
  }));
}

const { slug } = Astro.params;
const { title, cover, background } = Astro.props;
---

<AppLayout title={`${title} · Estante`} reader>
  <Reader client:only="react" slug={slug} title={title}>
    <div slot="fallback" class="reader-fallback" aria-label="Cargando libro"></div>
  </Reader>
  {/*
    Portada de apertura: comparte nombre de transición con la portada del estante, así que al
    abrir el libro se expande hasta el centro y se desvanece cuando el lector está listo. Al salir
    vuelve a aparecer para "cerrar el libro" hacia su sitio en el estante.
  */}
  <div class="reader-intro" transition:name={`book-${slug}`} style={{ background }} aria-hidden="true">
    <img src={cover} alt="" width="400" height="600" decoding="async" />
  </div>
</AppLayout>

<style is:global>
  .reader-fallback {
    position: fixed;
    inset: 0;
    background: var(--app-bg);
  }

  .reader-intro {
    position: fixed;
    z-index: 60;
    left: 50%;
    top: 50%;
    width: min(70vw, calc(62dvh * 2 / 3), 420px);
    aspect-ratio: 2 / 3;
    border-radius: 4px 9px 9px 4px;
    overflow: hidden;
    transform: translate(-50%, -50%);
    box-shadow:
      0 2px 3px rgb(0 0 0 / 0.18),
      0 24px 60px rgb(0 0 0 / 0.38);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out) 0.1s,
      transform 0.6s var(--ease-out) 0.1s;
  }

  .reader-intro img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  body:has(.reader[data-ready="true"]) .reader-intro {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.12);
  }

  html[data-closing] .reader-intro {
    opacity: 1 !important;
    transform: translate(-50%, -50%) !important;
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .reader-intro {
      transition-duration: 0.01s;
    }
  }
</style>
